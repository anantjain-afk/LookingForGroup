// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  username   String   @unique
  password   String?
  googleSub  String?  @unique
  emailVerifiedAt DateTime?
  avatar     String?
  bio        String?
  karmaScore Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lobbiesHosted Lobby[]            @relation("HostedLobbies")
  lobbiesJoined LobbyParticipant[]
  favoriteGames Game[]             @relation("UserFavoriteGames")
  sessions Session[]
  emailTokens EmailToken[]
  lobbyBans LobbyBan[]
}

model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  digest String @id
  purpose String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, purpose])
  @@index([expiresAt])
}

model Game {
  id        String   @id @default(cuid())
  igdbId    Int?     @unique
  name      String
  genre     String?
  imageUrl  String?
  metadata  Json?
  syncedAt  DateTime?
  lobbies   Lobby[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  favoritedBy User[] @relation("UserFavoriteGames")
}

model Tag {
  id       String     @id @default(cuid())
  name     String     @unique
  category String
  lobbies  LobbyTag[]
}

model Lobby {
  id          String  @id @default(cuid())
  title       String
  description String?
  status      String  @default("OPEN") // OPEN, FULL, IN_GAME
  maxPlayers  Int     @default(5)
  credentials String?
  platformId Int?
  region String?
  language String?

  hostId String
  host   User   @relation("HostedLobbies", fields: [hostId], references: [id])

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])

  participants LobbyParticipant[]
  bans LobbyBan[]
  tags         LobbyTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId, status])
}

model LobbyParticipant {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  lobbyId  String
  lobby    Lobby    @relation(fields: [lobbyId], references: [id])
  role     String   @default("MEMBER") // HOST, MEMBER
  isReady  Boolean  @default(false)
  joinedAt DateTime @default(now())
  disconnectedAt DateTime?

  @@unique([userId, lobbyId])
  @@index([disconnectedAt])
}

model LobbyBan {
  lobbyId String
  userId String
  lobby Lobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([lobbyId, userId])
}

model LobbyTag {
  lobbyId String
  lobby   Lobby  @relation(fields: [lobbyId], references: [id])
  tagId   String
  tag     Tag    @relation(fields: [tagId], references: [id])

  @@id([lobbyId, tagId])
}
