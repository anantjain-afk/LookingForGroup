# Browser HTTP requests stay on the frontend origin in production.
VITE_API_URL=
# Set to Render in production; local development defaults to localhost:3000.
VITE_SOCKET_URL=https://your-backend.onrender.com
# Vercel server-side API proxy target (not a browser variable).
API_ORIGIN=https://your-backend.onrender.com
# QA only: force voice through TURN, then rebuild.
VITE_FORCE_TURN=false
